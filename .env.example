# Local Docker development only. Copy to .env; never use these values in a deployment.
# Use URL-safe database credentials; otherwise set DOCKER_DATABASE_URL with encoded credentials.
# Required for the first local startup: choose your own 15–128-character password.
# Startup creates this admin only when no admin exists. Restarts never reset accounts.
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_NAME=Local Admin
LOCAL_ADMIN_PASSWORD=

POSTGRES_DB=hired_dev
POSTGRES_USER=hired_dev
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
ADMIN_PORT=5173
B2B_PORT=5174

# SeaweedFS local S3 API. Required even for storage-only Compose configuration.
# These are synthetic development credentials. Keep real values in ignored .env.
PRIVATE_UPLOADS_ENABLED=false
FILE_UPLOAD_ATTEMPTS_PER_MINUTE=12
CLAMAV_PORT=3310
SEAWEEDFS_PORT=8333
SEAWEEDFS_ACCESS_KEY_ID=hired-local-access
SEAWEEDFS_SECRET_ACCESS_KEY=local-development-secret-change-me
SEAWEEDFS_BUCKET=hired-dev-private
SEAWEEDFS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Development image/tooling candidates, verified upstream on 2026-10-14.
# Application compatibility and image builds still need validation after initialization.
NODE_IMAGE=node:26.11.1-bookworm-slim
PNPM_VERSION=12.11.2
# The initialized backend owns its compatible package-manager version separately.
BACKEND_PNPM_VERSION=12.14.0
ADMIN_PNPM_VERSION=12.5.1
# Optional overrides. Local Compose generates/persists independent keys when blank.
COMMAND_FINGERPRINT_KEY=
AUTH_SESSION_KEY=
DOCUMENT_NUMBER_ENCRYPTION_KEY=
DOCUMENT_NUMBER_KEY_ID=local-v1
# Optional JSON map of previous key IDs to base64url keys, for protected recovery.
# DOCUMENT_NUMBER_PREVIOUS_KEYS={}

# Optional: override the generated in-container URL when credentials require URL encoding.
# DOCKER_DATABASE_URL=postgresql://hired_dev:local-dev-only-change-me@postgres:5432/hired_dev?schema=public

# Independent trip close-code key. Compose persists a random local key when blank.
TRIP_CODE_ENCRYPTION_KEY=
TRIP_CODE_KEY_ID=local-v1
# Retain old key IDs until all affected trips close. Never reuse an ID.
# TRIP_CODE_PREVIOUS_KEYS={}
