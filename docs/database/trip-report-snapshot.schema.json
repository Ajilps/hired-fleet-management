{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hired:trip-report-snapshot:v1",
  "title": "HireD immutable trip report snapshot v1",
  "description": "Proposed closure contract. Services must also reconcile relational IDs, money totals, timestamps and ownership; JSON Schema alone does not enforce those invariants.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reportId": {
      "$ref": "#/$defs/id"
    },
    "snapshotVersion": {
      "const": 1
    },
    "generatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "currency": {
      "const": "INR"
    },
    "trip": {
      "$ref": "#/$defs/trip"
    },
    "expenses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expense"
      }
    },
    "totalExpenseAmount": {
      "$ref": "#/$defs/money"
    },
    "payroll": {
      "$ref": "#/$defs/payroll"
    },
    "walletCredit": {
      "$ref": "#/$defs/walletCredit"
    }
  },
  "required": [
    "reportId",
    "snapshotVersion",
    "generatedAt",
    "currency",
    "trip",
    "expenses",
    "totalExpenseAmount",
    "payroll",
    "walletCredit"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "money": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,9})\\.[0-9]{2}$",
      "description": "INR, exact two-decimal nonnegative amount; numeric(12,2)."
    },
    "percent": {
      "type": "string",
      "pattern": "^(?:100\\.00|(?:[0-9]|[1-9][0-9])\\.[0-9]{2})$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "address"
      ],
      "dependentRequired": {
        "latitude": [
          "longitude"
        ],
        "longitude": [
          "latitude"
        ]
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source": {
          "enum": [
            "maps",
            "admin_override",
            null
          ]
        }
      },
      "required": [
        "durationMinutes",
        "source"
      ],
      "oneOf": [
        {
          "properties": {
            "durationMinutes": {
              "type": "null"
            },
            "source": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "durationMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "enum": [
                "maps",
                "admin_override"
              ]
            }
          }
        }
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "driverId": {
          "$ref": "#/$defs/id"
        },
        "assignedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "endedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "enum": [
            "replaced",
            "completed",
            "cancelled"
          ]
        }
      },
      "required": [
        "id",
        "driverId",
        "assignedAt",
        "endedAt",
        "status"
      ]
    },
    "expense": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "driverId": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "amount": {
          "allOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "not": {
                "const": "0.00"
              }
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "receiptAssetId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "loggedAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "id",
        "driverId",
        "category",
        "amount",
        "description",
        "receiptAssetId",
        "loggedAt"
      ]
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "orderId": {
          "$ref": "#/$defs/id"
        },
        "companyId": {
          "$ref": "#/$defs/id"
        },
        "companyName": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "name"
          ]
        },
        "status": {
          "const": "closed"
        },
        "pickup": {
          "$ref": "#/$defs/location"
        },
        "drop": {
          "$ref": "#/$defs/location"
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "phone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          },
          "required": [
            "name",
            "phone"
          ]
        },
        "vehicleNotes": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceNotes": {
          "type": [
            "string",
            "null"
          ]
        },
        "scheduledPickupAt": {
          "$ref": "#/$defs/timestamp"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "closedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        },
        "actualDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "expensesConfirmedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expensesConfirmedByDriverId": {
          "$ref": "#/$defs/id"
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        }
      },
      "required": [
        "id",
        "orderId",
        "companyId",
        "companyName",
        "driver",
        "status",
        "pickup",
        "drop",
        "contact",
        "vehicleNotes",
        "serviceNotes",
        "scheduledPickupAt",
        "startedAt",
        "closedAt",
        "estimate",
        "actualDurationSeconds",
        "expensesConfirmedAt",
        "expensesConfirmedByDriverId",
        "assignments"
      ]
    },
    "payroll": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tripAmount": {
          "$ref": "#/$defs/money"
        },
        "appliedDriverPercent": {
          "$ref": "#/$defs/percent"
        },
        "appliedCompanyPercent": {
          "$ref": "#/$defs/percent"
        },
        "driverShareAmount": {
          "$ref": "#/$defs/money"
        },
        "companyShareAmount": {
          "$ref": "#/$defs/money"
        },
        "totalAmount": {
          "$ref": "#/$defs/money"
        },
        "paymentStatusAtClosure": {
          "enum": [
            "unpaid",
            "settled",
            "disputed"
          ]
        },
        "payoutStatusAtClosure": {
          "const": "credited"
        }
      },
      "required": [
        "id",
        "tripAmount",
        "appliedDriverPercent",
        "appliedCompanyPercent",
        "driverShareAmount",
        "companyShareAmount",
        "totalAmount",
        "paymentStatusAtClosure",
        "payoutStatusAtClosure"
      ]
    },
    "walletCredit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "amount": {
          "$ref": "#/$defs/money"
        }
      },
      "required": [
        "id",
        "amount"
      ]
    }
  }
}
