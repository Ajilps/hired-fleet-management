generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin   @map("admin")
  Partner @map("partner")
  Driver  @map("driver")

  @@map("user_role")
}

// Implemented identity, command replay and audit tables map to hired.dbml.
// UUIDs and timestamps are supplied explicitly, preserving the design defaults.
model User {
  id           String        @id(map: "pk_users") @db.Uuid
  email        String        @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         UserRole
  fullName     String        @map("full_name") @db.VarChar(150)
  phone        String?       @db.VarChar(30)
  isActive     Boolean       @default(true) @map("is_active")
  passwordChangeRequired Boolean @default(false) @map("password_change_required")
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime      @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @map("updated_at") @db.Timestamptz(6)
  authSessions AuthSession[]
  commandReplays CommandReplay[]
  auditLogs AuditLog[]
  companyMemberships CompanyUser[]
  createdPayoutRates CompanyPayoutRate[]
  driver Driver? @relation("DriverAccount")
  activatedDrivers Driver[] @relation("DriverActivator")
  uploadedFileAssets FileAsset[]
  fileUploadIntents FileUploadIntent[]

  @@index([createdAt, id], map: "ix_users_created_at_id")
  @@map("users")
}

model AuthSession {
  id               String    @id(map: "pk_auth_sessions") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "uq_auth_sessions_refresh_token_hash") @map("refresh_token_hash") @db.VarChar(255)
  deviceName       String?   @map("device_name") @db.VarChar(150)
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)
  transport        String    @default("token") @db.VarChar(10)
  consumedTokens   AuthRefreshToken[]
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_auth_sessions_user_id")

  @@index([userId, expiresAt], map: "ix_auth_sessions_user_id_expires_at")
  @@map("auth_sessions")
}

model AuthRefreshToken {
  tokenHash  String      @id(map: "pk_auth_refresh_tokens") @map("token_hash") @db.VarChar(64)
  sessionId  String      @map("session_id") @db.Uuid
  consumedAt DateTime    @map("consumed_at") @db.Timestamptz(6)
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_auth_refresh_tokens_session_id")

  @@index([sessionId], map: "ix_auth_refresh_tokens_session_id")
  @@map("auth_refresh_tokens")
}

model AuthRateLimit {
  keyHash      String   @id(map: "pk_auth_rate_limits") @map("key_hash") @db.VarChar(64)
  attempts     Int
  windowEndsAt DateTime @map("window_ends_at") @db.Timestamptz(6)

  @@index([windowEndsAt], map: "ix_auth_rate_limits_window_ends_at")
  @@map("auth_rate_limits")
}

model CommandReplay {
  id                 String   @id(map: "pk_command_replays") @db.Uuid
  actorUserId        String   @map("actor_user_id") @db.Uuid
  requestMethod      String   @map("request_method") @db.VarChar(6)
  canonicalPath      String   @map("canonical_path") @db.VarChar(512)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(100)
  requestFingerprint String   @map("request_fingerprint") @db.VarChar(64)
  outcome            String   @db.VarChar(10)
  responseStatus     Int      @map("response_status") @db.SmallInt
  responseBody       Json     @map("response_body") @db.JsonB
  responseHeaders    Json     @map("response_headers") @db.JsonB
  createdAt          DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  actor              User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict, map: "fk_command_replays_actor_user_id")

  @@unique([actorUserId, requestMethod, canonicalPath, idempotencyKey], map: "uq_command_replays_scope")
  @@index([expiresAt], map: "ix_command_replays_expires_at")
  @@map("command_replays")
}

model AuditLog {
  id          BigInt   @id(map: "pk_audit_logs") @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  action      String   @db.VarChar(80)
  beforeData  Json?    @map("before_data") @db.JsonB
  afterData   Json?    @map("after_data") @db.JsonB
  requestId   String?  @map("request_id") @db.Uuid
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, map: "fk_audit_logs_actor_user_id")

  @@index([entityType, entityId, createdAt], map: "ix_audit_logs_entity_type_entity_id_created_at")
  @@index([actorUserId, createdAt], map: "ix_audit_logs_actor_user_id_created_at")
  @@map("audit_logs")
}

model Company {
  id             String   @id(map: "pk_companies") @db.Uuid
  legalName      String   @map("legal_name") @db.VarChar(200)
  displayName    String   @map("display_name") @db.VarChar(200)
  contactName    String   @map("contact_name") @db.VarChar(150)
  contactEmail   String   @map("contact_email") @db.VarChar(255)
  contactPhone   String   @map("contact_phone") @db.VarChar(30)
  billingAddress String   @map("billing_address") @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)
  memberships    CompanyUser[]
  payoutRates    CompanyPayoutRate[]

  @@index([createdAt, id], map: "ix_companies_created_at_id")
  @@map("companies")
}

model CompanyUser {
  companyId        String   @map("company_id") @db.Uuid
  userId           String   @unique(map: "uq_partner_company_membership") @map("user_id") @db.Uuid
  isPrimaryContact Boolean  @default(false) @map("is_primary_contact")
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, map: "fk_company_users_company_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict, map: "fk_company_users_user_id")

  @@id([companyId, userId], map: "pk_company_users")
  @@index([companyId, createdAt, userId], map: "ix_company_users_company_id_created_at_user_id")
  @@map("company_users")
}

model CompanyPayoutRate {
  id              String   @id(map: "pk_company_payout_rates") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  driverPercent   Decimal  @map("driver_percent") @db.Decimal(5,2)
  companyPercent  Decimal  @map("company_percent") @db.Decimal(5,2)
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(3)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(3)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @map("created_at") @db.Timestamptz(3)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, map: "fk_company_payout_rates_company_id")
  creator         User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_company_payout_rates_created_by_user_id")

  @@unique([companyId, effectiveFrom], map: "uq_company_payout_rates_company_id_effective_from")
  @@index([companyId, createdAt, id], map: "ix_company_payout_rates_company_id_created_at_id")
  @@map("company_payout_rates")
}

enum DriverStatus {
  Pending @map("pending")
  Active @map("active")
  Inactive @map("inactive")
  Suspended @map("suspended")

  @@map("driver_status")
}

model Driver {
  id String @id(map: "pk_drivers") @db.Uuid
  userId String @unique(map: "uq_drivers_user_id") @map("user_id") @db.Uuid
  status DriverStatus @default(Pending)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  homeAddress String? @map("home_address") @db.Text
  onlineStatus Boolean @default(false) @map("online_status")
  onboardedAt DateTime? @map("onboarded_at") @db.Timestamptz(6)
  activatedByUserId String? @map("activated_by_user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  user User @relation("DriverAccount", fields: [userId], references: [id], onDelete: Restrict, map: "fk_drivers_user_id")
  activator User? @relation("DriverActivator", fields: [activatedByUserId], references: [id], onDelete: Restrict, map: "fk_drivers_activated_by_user_id")
  fileAssets FileAsset[]

  @@index([createdAt, id], map: "ix_drivers_created_at_id")
  @@index([status, createdAt, id], map: "ix_drivers_status_created_at_id")
  @@map("drivers")
}

// Private metadata only: object bytes remain in S3-compatible storage.
// Purpose/context/identity are immutable; future attachment/scan workflows own transitions.
model FileAsset {
  id String @id(map: "pk_file_assets") @db.Uuid
  storageKey String @unique(map: "uq_file_assets_storage_key") @map("storage_key") @db.VarChar(500)
  originalFilename String @map("original_filename") @db.VarChar(255)
  mimeType String @map("mime_type") @db.VarChar(100)
  byteSize BigInt @map("byte_size")
  checksumSha256 String @map("checksum_sha256") @db.Char(64)
  malwareScanStatus String @default("pending") @map("malware_scan_status") @db.VarChar(20)
  purpose String @db.VarChar(40)
  driverId String @map("driver_id") @db.Uuid
  uploadedByUserId String @map("uploaded_by_user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  uploadIntent FileUploadIntent?
  uploader User @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict, map: "fk_file_assets_uploaded_by_user_id")
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict, map: "fk_file_assets_driver_id")

  @@index([uploadedByUserId, createdAt, id], map: "ix_file_assets_uploaded_by_user_id_created_at_id")
  @@index([driverId, createdAt, id], map: "ix_file_assets_driver_id_created_at_id")
  @@map("file_assets")
}

model FileUploadIntent {
  assetId String @id(map: "pk_file_upload_intents") @map("asset_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestFingerprint String @map("request_fingerprint") @db.Char(64)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  asset FileAsset @relation(fields: [assetId], references: [id], onDelete: Restrict, map: "fk_file_upload_intents_asset_id")
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, map: "fk_file_upload_intents_actor_user_id")

  @@unique([actorUserId, idempotencyKey], map: "uq_file_upload_intents_actor_user_id_idempotency_key")
  @@map("file_upload_intents")
}
