# Copy to .env.dev for a host-run API. These credentials are local examples only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://hired_dev:local-dev-only-change-me@127.0.0.1:5432/hired_dev
# Optional privileged connection, used only by the Prisma CLI, never by the API.
# MIGRATION_DATABASE_URL=postgresql://migration-user:replace-me@127.0.0.1:5432/hired_dev
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_QUERY_TIMEOUT_MS=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
# Generate a unique key: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
# Required to start authentication; never commit the generated value.
AUTH_SESSION_KEY=
# Generate independently with the same randomBytes command; keep stable for replay retention.
COMMAND_FINGERPRINT_KEY=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REFRESH_IP_LIMIT=120
# For .env.test only: a disposable, already migrated database. Tests do not migrate/reset it.
# TEST_DATABASE_URL=postgresql://hired_test:synthetic-test-only@127.0.0.1:55438/hired_backend_test

# Private uploads are opt-in. Metadata/auth still run when dependencies are unavailable.
# Set true after starting SeaweedFS and ClamAV; use synthetic documents until DEC-22.
PRIVATE_UPLOADS_ENABLED=false
FILE_UPLOAD_ATTEMPTS_PER_MINUTE=12
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hired-dev-private
STORAGE_ACCESS_KEY_ID=hired-local-access
STORAGE_SECRET_ACCESS_KEY=local-development-secret-change-me
STORAGE_FORCE_PATH_STYLE=true
STORAGE_TIMEOUT_MS=5000
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
# Explicit loopback endpoint required only for test:storage / test:files:live.
# TEST_STORAGE_ENDPOINT=http://127.0.0.1:8333
